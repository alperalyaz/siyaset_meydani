{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": ["arn1"],
  "framework": "vite",
  "rewrites": [
    { "source": "/s/:slug", "destination": "/api/session-page?slug=:slug" },
    { "source": "/sitemap.xml", "destination": "/api/sitemap" },
    { "source": "/oturumlar", "destination": "/api/sessions-page" },
    { "source": "/((?!api/|_vercel/).*)", "destination": "/" }
  ]
}
